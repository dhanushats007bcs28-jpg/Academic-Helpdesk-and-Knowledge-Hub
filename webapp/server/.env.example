# Server
PORT=3000
NODE_ENV=development

# MongoDB (real instance)
MONGO_URI=mongodb://127.0.0.1:27017/academic_helpdesk

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SLA engine
# Working hours per day used by the 24-working-hour SLA timer (Mon-Fri)
# Support window: 06:00 AM to 12:00 AM (midnight)
WORKDAY_HOURS=18
WORKDAY_START=06:00
WORKDAY_END=23:59
SLA_HOURS=24
